# Copy this file to .env and fill in the values.
# Supabase dashboard > Project Settings > API
#
# Only the ANON key belongs here. It ships inside the browser bundle, so it is
# public by design — Row Level Security is what actually protects the data.
# The service_role key must NEVER appear in this file or anywhere in src/.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
